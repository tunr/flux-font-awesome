{
    "name": "tunr/flux-font-awesome",
    "description": "Font Awesome icon integration for Laravel Flux UI component library",
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "font-awesome",
        "icons",
        "components"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tunr",
            "email": "capellion@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "symfony/dom-crawler": "^7.0|^8.0",
        "symfony/css-selector": "^7.0|^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.5|^10.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Tunr\\FluxFontAwesome\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tunr\\FluxFontAwesome\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tunr\\FluxFontAwesome\\FluxFontAwesomeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "larastan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "rector": "vendor/bin/rector",
        "rector:dry": "vendor/bin/rector --dry-run",
        "check": [
            "@test",
            "@larastan",
            "@pint:test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
