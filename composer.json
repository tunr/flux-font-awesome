{
    "name": "tunr/flux-font-awesome",
    "description": "Font Awesome icon integration for the Laravel Flux UI component library",
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "font-awesome",
        "icons",
        "components"
    ],
    "homepage": "https://github.com/tunr/flux-font-awesome",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tunr"
        }
    ],
    "support": {
        "issues": "https://github.com/tunr/flux-font-awesome/issues",
        "source": "https://github.com/tunr/flux-font-awesome"
    },
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/flux": "^2.1",
        "symfony/css-selector": "^7.0|^8.0",
        "symfony/dom-crawler": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tunr\\FluxFontAwesome\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tunr\\FluxFontAwesome\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tunr\\FluxFontAwesome\\FluxFontAwesomeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "larastan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "check": [
            "@test",
            "@larastan",
            "@pint:test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
