includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
        - config
    excludePaths:
        - tests
    tmpDir: build/phpstan
    ignoreErrors:
        # Laravel Command::$components is intentionally internal but meant to be used
        - '#Access to internal property Illuminate\\Console\\Command::\$components#'
